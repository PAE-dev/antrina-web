{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PORT",
    "CORS_ORIGINS",
    "ADMIN_ORIGIN",
    "ADMIN_ENCRYPTION_KEY",
    "ADMIN_PASSWORD",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_PUBLIC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "PUBLIC_API_URL",
        "PUBLIC_SITE_URL",
        "PUBLIC_WHATSAPP_NUMBER",
        "PUBLIC_CONTACT_EMAIL",
        "PUBLIC_GOOGLE_SITE_VERIFICATION",
        "VITE_API_URL",
        "VITE_STORE_URL",
        "VERCEL",
        "MEDIA_HOST"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
