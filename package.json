{
  "name": "antrina",
  "private": true,
  "description": "Antrina: e-commerce de artesanías (monorepo Astro + NestJS, arquitectura hexagonal)",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@antrina/web...",
    "dev:api": "turbo run dev --filter=@antrina/api...",
    "dev:admin": "turbo run dev --filter=@antrina/admin... --filter=@antrina/api...",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "storage:up": "docker compose up -d minio minio-init",
    "services:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @antrina/api db:migrate",
    "db:seed": "pnpm --filter @antrina/api db:seed",
    "db:studio": "pnpm --filter @antrina/api db:studio",
    "admin:create": "pnpm --filter @antrina/api admin:create"
  },
  "devDependencies": {
    "@antrina/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
