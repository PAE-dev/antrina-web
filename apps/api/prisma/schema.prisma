generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  PEN
  USD
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductBadge {
  NEW
  CUSTOMIZABLE
  LIMITED_EDITION
}

enum ProductSize {
  MINI
  STANDARD
  LARGE
  SIGNATURE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  WHATSAPP
  STORE
  INSTAGRAM
  FACEBOOK
  IN_PERSON
  OTHER
}

enum PaymentMethod {
  YAPE
  PLIN
  TRANSFER
  CASH
  CARD
  OTHER
}

enum StockMovementType {
  INITIAL
  RESTOCK
  SALE
  SALE_CANCELLED
  ADJUSTMENT
}

/// Tipo de producto: categoría y, como máximo, un nivel de subcategoría (`parentId`).
model Category {
  id           String                @id @default(cuid())
  /// Slug en español; el de cada idioma vive en la traducción.
  slug         String                @unique
  sortOrder    Int                   @default(0)
  parentId     String?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([parentId])
}

/// locale es un código corto ('es', 'en'). Se valida en el dominio; no es enum para no migrar al sumar idiomas.
model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  slug        String
  description String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model Product {
  id                  String               @id @default(cuid())
  sku                 String               @unique
  categoryId          String
  category            Category             @relation(fields: [categoryId], references: [id])
  /// Precio de venta actual. Si hay oferta, `compareAtPriceCents` guarda el precio normal.
  priceCents          Int
  compareAtPriceCents Int?
  /// Costo interno para calcular el margen. Nunca se expone en la tienda.
  costCents           Int?
  currency            Currency             @default(PEN)
  /// Existencias actuales. Solo cambia junto a un StockMovement (ventas, entradas y ajustes).
  stock               Int                  @default(0)
  /// Con este stock o menos, el panel avisa de stock bajo.
  lowStockThreshold   Int                  @default(3)
  status              ProductStatus        @default(DRAFT)
  isFeatured          Boolean              @default(false)
  badge               ProductBadge?
  size                ProductSize?
  /// Código de intención ('abundancia', 'amor'…), opcional. Se valida en el dominio.
  intention           String?
  /// Códigos de signo zodiacal ('ARIES', 'TAURUS'…). Se validan en el dominio.
  signs               String[]             @default([])
  origin              String?
  translations        ProductTranslation[]
  images              ProductImage[]
  orderLines          OrderLine[]
  stockMovements      StockMovement[]
  pieces              ProductPiece[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, isFeatured])
  @@index([categoryId])
  @@index([intention])
}

/// Pieza física con QR propio. `code` es aleatorio y va impreso en la etiqueta (`/q/<code>`).
model ProductPiece {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Número correlativo dentro del producto, para identificar la etiqueta.
  serial        Int
  code          String    @unique
  /// Etiqueta perdida o dañada: el código deja de ser válido.
  voidedAt      DateTime?
  /// Mensaje de quien regala; se puede cambiar hasta que la pieza tenga dueño.
  giftFrom      String?
  giftTo        String?
  giftMessage   String?
  giftUpdatedAt DateTime?
  torito        Torito?
  createdAt     DateTime  @default(now())

  @@unique([productId, serial])
}

/// Torito digital de una pieza: el primero que la reclama con su cuenta es su dueño.
model Torito {
  id          String       @id @default(cuid())
  pieceId     String       @unique
  piece       ProductPiece @relation(fields: [pieceId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name        String
  colorCode   String
  intention   String?
  /// Último día visitado, `AAAA-MM-DD` en hora de Lima.
  lastVisitOn String?
  visitStreak Int          @default(0)
  claimedAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([customerId])
}

/// Historial de existencias: cada cambio de `Product.stock` deja una fila.
model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        StockMovementType
  /// Positivo si entra, negativo si sale.
  quantity    Int
  stockAfter  Int
  note        String?
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminUserId String?
  adminUser   AdminUser?        @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Cliente de la tienda. El teléfono (E.164) es la clave para unirlo con WhatsApp.
model Customer {
  id            String            @id @default(cuid())
  name          String
  phone         String?           @unique
  email         String?
  note          String?
  /// Identificador de su cuenta de Google (`sub`); null si solo existe en el panel.
  googleSubject String?           @unique
  lastLoginAt   DateTime?
  orders        Order[]
  sessions      CustomerSession[]
  toritos       Torito[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([name])
}

model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

/// Venta, registrada a mano desde el panel o, en el futuro, desde el checkout de la tienda.
model Order {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement())
  status        OrderStatus     @default(PAID)
  channel       OrderChannel    @default(WHATSAPP)
  paymentMethod PaymentMethod?
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  currency      Currency        @default(PEN)
  subtotalCents Int
  shippingCents Int             @default(0)
  discountCents Int             @default(0)
  totalCents    Int
  note          String?
  /// Fecha real de la venta; puede ser anterior a cuando se registró.
  soldAt        DateTime        @default(now())
  createdById   String?
  createdBy     AdminUser?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  movements     StockMovement[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, soldAt])
  @@index([soldAt])
  @@index([customerId])
}

/// `sku` y `name` son copia del momento de la venta: el producto puede cambiar después.
model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku            String
  name           String
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
  @@index([productId])
}

/// Foto de producto guardada en el almacenamiento de objetos (MinIO local / Cloudflare R2).
/// `storageKey` es la ruta dentro del bucket; la URL pública se construye en la API.
model ProductImage {
  id           String                    @id @default(cuid())
  productId    String
  product      Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey   String                    @unique
  position     Int
  width        Int
  height       Int
  contentType  String
  sizeBytes    Int
  translations ProductImageTranslation[]
  createdAt    DateTime                  @default(now())

  @@index([productId, position])
}

/// Texto alternativo por idioma (accesibilidad y SEO).
model ProductImageTranslation {
  id      String       @id @default(cuid())
  imageId String
  image   ProductImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  locale  String
  alt     String

  @@unique([imageId, locale])
}

model ProductTranslation {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale          String
  name            String
  slug            String
  description     String
  /// Título y descripción para buscadores; si faltan se usan el nombre y la descripción.
  metaTitle       String?
  metaDescription String?

  @@unique([productId, locale])
  @@unique([locale, slug])
}

/// Fotos editoriales de la tienda (portada, historia…), una por `slot`.
model SiteImage {
  id           String                 @id @default(cuid())
  slot         String                 @unique
  storageKey   String                 @unique
  width        Int
  height       Int
  contentType  String
  sizeBytes    Int
  translations SiteImageTranslation[]
  updatedAt    DateTime               @updatedAt
}

model SiteImageTranslation {
  id      String    @id @default(cuid())
  imageId String
  image   SiteImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  locale  String
  alt     String

  @@unique([imageId, locale])
}

enum AdminRole {
  OWNER
  EDITOR
}

/// Personal del panel de administración. Cuentas separadas de los clientes de la tienda.
model AdminUser {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  role           AdminRole       @default(EDITOR)
  /// Secreto TOTP cifrado con AES-256-GCM. Pendiente de confirmar mientras totpEnabledAt sea null.
  totpSecretEnc  String?
  totpEnabledAt  DateTime?
  failedLogins   Int             @default(0)
  lockedUntil    DateTime?
  isActive       Boolean         @default(true)
  lastLoginAt    DateTime?
  sessions       AdminSession[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  orders         Order[]
}

/// Sesión del panel. Solo se guarda el hash SHA-256 del token de la cookie.
model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  changes     Json?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Promotion {
  id           String       @id @default(cuid())
  code         String?      @unique
  name         String
  discountType DiscountType
  /// Porcentaje (1-100) o céntimos según discountType.
  value        Int
  startsAt     DateTime     @default(now())
  endsAt       DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
