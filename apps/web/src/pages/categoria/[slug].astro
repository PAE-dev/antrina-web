---
import CategoryView from '../../components/views/CategoryView.astro';
import MessageView from '../../components/views/MessageView.astro';
import NotFoundView from '../../components/views/NotFoundView.astro';
import { getPageCopy } from '../../i18n/pages';
import { CATALOG_CACHE_CONTROL } from '../../lib/catalog';
import { loadCategory } from '../../lib/page-data';
import { alternatesFor, routes, TREES_CATEGORY_SLUG } from '../../lib/routes';

export const prerender = false;
const data = await loadCategory('es', Astro.params.slug ?? '');
const copy = getPageCopy('es');

if (data.status === 'ok') {
  // Los árboles tienen su propio catálogo: una sola URL para Google.
  if (data.category.slug === TREES_CATEGORY_SLUG) {
    return Astro.redirect(routes.catalog('es'), 301);
  }
  Astro.response.headers.set('Cache-Control', CATALOG_CACHE_CONTROL);
} else if (data.status === 'not_found') {
  Astro.response.status = 404;
} else {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}
---

{data.status === 'ok' ? (
  <CategoryView locale="es" {...data} />
) : data.status === 'not_found' ? (
  <NotFoundView locale="es" />
) : (
  <MessageView
    locale="es"
    alternates={alternatesFor((code) => routes.category(code))}
    label="503"
    title={copy.category.unavailableTitle}
    text={copy.product.unavailableText}
    cta={{ label: copy.notFound.cta, href: routes.home('es') }}
  />
)}
