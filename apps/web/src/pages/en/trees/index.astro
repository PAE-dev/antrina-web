---
import CatalogView from '../../../components/views/CatalogView.astro';
import { CATALOG_CACHE_CONTROL, listProducts } from '../../../lib/catalog';

export const prerender = false;
const products = await listProducts({ locale: 'en' });
Astro.response.headers.set('Cache-Control', CATALOG_CACHE_CONTROL);
---

<CatalogView locale="en" products={products} />
