---
import { type LocaleCode } from '@antrina/contracts';
import { AnnouncementBar, SiteFooter, SiteHeader } from '@antrina/ui';
import { getDictionary } from '../i18n/dictionaries';
import {
  buildFooterColumns,
  buildMainNavigation,
  localeOptionsFor,
  SOCIAL_LINKS,
} from '../lib/navigation';
import { type Alternates, routes } from '../lib/routes';
import { type JsonLd } from '../lib/structured-data';
import BaseLayout, { type SeoImage } from './BaseLayout.astro';

interface Props {
  locale: LocaleCode;
  title: string;
  description: string;
  alternates: Alternates;
  canonical?: string;
  image?: SeoImage;
  type?: 'website' | 'product' | 'article';
  noindex?: boolean;
  jsonLd?: JsonLd[];
}

const { locale, alternates, ...seo } = Astro.props;
const t = getDictionary(locale);
const locales = localeOptionsFor(locale, alternates);
---

<BaseLayout locale={locale} alternates={alternates} {...seo}>
  <AnnouncementBar
    message={t.announcement}
    note={t.shippingNote}
    locales={locales}
    languageLabel={t.header.language}
  />
  <SiteHeader
    client:load
    homeHref={routes.home(locale)}
    searchAction={routes.search(locale)}
    accountHref={routes.account(locale)}
    cartHref={routes.cart(locale)}
    cartCount={0}
    navigation={buildMainNavigation(locale, t)}
    locales={locales}
    labels={t.header}
  />
  <main id="contenido">
    <slot />
  </main>
  <SiteFooter
    homeHref={routes.home(locale)}
    homeLabel={t.header.home}
    slogan={t.footer.slogan}
    tagline={t.footer.tagline}
    columns={buildFooterColumns(locale, t)}
    socials={SOCIAL_LINKS}
    socialLabel={t.footer.socialLabel}
    locales={locales}
    languageLabel={t.header.language}
    rights={t.footer.rights}
  />
</BaseLayout>
