---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/global.css';
import { type LocaleCode } from '@antrina/contracts';
import { HTML_LANG, LOCALES, localePath } from '../i18n/config';

interface Props {
  locale: LocaleCode;
  title: string;
  description: string;
  path?: string;
}

const { locale, title, description, path = '/' } = Astro.props;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1ea" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {LOCALES.map((code) => (
      <link rel="alternate" hreflang={HTML_LANG[code]} href={localePath(code, path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={localePath('es', path)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
