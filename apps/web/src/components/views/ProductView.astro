---
import { type LocaleCode, type ProductDetailDto, type ProductSummaryDto } from '@antrina/contracts';
import { ArrowLink, formatMoney, Photo, ButtonLink, PortalIcon, ProductList } from '@antrina/ui';
import { stoneById } from '../../content/stones';
import { getDictionary } from '../../i18n/dictionaries';
import { getPageCopy } from '../../i18n/pages';
import { intentionByCategory, productTag, signByCode, sizeByCode } from '../../i18n/taxonomy';
import { getCategories } from '../../lib/catalog';
import StoreLayout from '../../layouts/StoreLayout.astro';
import { cardImage, SIZES, toImageSource } from '../../lib/images';
import { alternatesFor, productPath, routes, TREES_CATEGORY_SLUG } from '../../lib/routes';
import { absoluteUrl, whatsappUrl } from '../../lib/site';
import { breadcrumbs, type Crumb, product as productJsonLd } from '../../lib/structured-data';
import Breadcrumbs from '../Breadcrumbs.astro';

interface Props {
  locale: LocaleCode;
  product: ProductDetailDto;
  related: ProductSummaryDto[];
}

const { locale, product, related } = Astro.props;
const t = getDictionary(locale);
const copy = getPageCopy(locale);
const isTree = product.categorySlug === TREES_CATEGORY_SLUG;
const intention = product.intention ? intentionByCategory(product.intention) : undefined;
const tag = productTag(locale, product);
const size = product.size ? sizeByCode(product.size) : undefined;
const signs = product.signs.flatMap((code) => signByCode(code) ?? []);
const stones = intention?.stones.flatMap((id) => stoneById(id) ?? []) ?? [];
// Un torito trae su QR: la ficha cuenta que tiene un mundo, igual que la app lo decide por categoría.
const categories = (await getCategories(locale)) ?? [];
const ownCategory = categories.find((category) => category.slug === product.categorySlug);
const parentSlug = categories.find((category) => category.id === ownCategory?.parentId)?.slug;
const opensWorld = [product.categorySlug, parentSlug].some((slug) => slug?.startsWith('torito'));

/** Sin traducción propia en un idioma, esa versión no se indexa y apunta a la española. */
const alternates = alternatesFor((code) => {
  const slug = product.slugs[code];
  return slug ? productPath(code, slug, product.categorySlug) : null;
});
const path = productPath(locale, product.slug, product.categorySlug);
const categoryHref = isTree
  ? routes.catalog(locale)
  : routes.category(locale, product.category.slug);
const canonical = alternates[locale] ?? alternates.es ?? path;
const isTranslated = Boolean(product.slugs[locale]);

const trail: Crumb[] = [
  { name: copy.home, path: routes.home(locale) },
  isTree && intention
    ? { name: intention.copy[locale].label, path: routes.intention(locale, intention.slug[locale]) }
    : { name: isTree ? copy.catalog.label : product.category.name, path: categoryHref },
  { name: product.name, path },
];

const images = product.images.map((image, index) =>
  toImageSource(
    image,
    SIZES.gallery,
    `${product.name} · ${copy.product.photo(index + 1, product.images.length)}`,
  )!,
);
const description =
  product.metaDescription ??
  (isTree
    ? copy.product.metaDescription(product.name, intention ? tag : '')
    : copy.product.itemMetaDescription(product.name, product.category.name));
const orderHref =
  whatsappUrl(copy.product.whatsappMessage(product.name, absoluteUrl(canonical))) ??
  routes.contact(locale);
const paragraphs = product.description.split(/\n{2,}/).filter(Boolean);
const firstImage = product.images[0];
---

<StoreLayout
  locale={locale}
  title={product.metaTitle ?? product.name}
  description={description}
  alternates={alternates}
  canonical={canonical}
  noindex={!isTranslated}
  type="product"
  image={
    firstImage
      ? {
          url: firstImage.url,
          width: firstImage.width,
          height: firstImage.height,
          alt: firstImage.alt || product.name,
        }
      : undefined
  }
  jsonLd={[breadcrumbs(trail), productJsonLd(product, locale, canonical, tag)]}
>
  <article class="pb-20 pt-6 md:pb-32 md:pt-10">
    <div class="container-page flex flex-col gap-8 md:gap-10">
      <Breadcrumbs items={trail} label={copy.breadcrumb} />

      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          {images.length > 0 ? (
            <ul
              class="-mx-5 flex snap-x snap-mandatory gap-2 overflow-x-auto px-5 md:mx-0 md:grid md:grid-cols-2 md:gap-3 md:overflow-visible md:px-0"
              aria-label={copy.product.details}
            >
              {images.map((image, index) => (
                <li
                  class:list={[
                    'shrink-0 snap-center md:w-auto',
                    images.length > 1 ? 'w-[85%]' : 'w-full',
                    index === 0 && 'md:col-span-2',
                  ]}
                >
                  <Photo image={image} label={product.name} priority={index === 0} />
                </li>
              ))}
            </ul>
          ) : (
            <Photo label={t.productPhoto} />
          )}
        </div>

        <div class="lg:col-span-5">
          <div class="flex flex-col gap-8 lg:sticky lg:top-28">
            <div class="flex flex-col gap-4">
              {tag && <p class="type-label">{tag}</p>}
              <h1 class="type-h2">{product.name}</h1>
              <p class="type-price flex flex-wrap items-baseline gap-x-2.5 text-[18px]">
                <span>{formatMoney(product.price, locale)}</span>
                {product.compareAtPrice && (
                  <del class="text-[15px] font-normal text-text-muted">
                    {formatMoney(product.compareAtPrice, locale)}
                  </del>
                )}
              </p>
              <p class="type-label inline-flex items-center gap-2 text-text-secondary">
                <span
                  aria-hidden="true"
                  class:list={[
                    'size-1.5 rounded-full',
                    product.isPurchasable ? 'bg-brand' : 'bg-clay',
                  ]}
                />
                {product.isPurchasable
                  ? copy.product.inStock
                  : isTree
                    ? copy.product.outOfStock
                    : copy.product.outOfStockItem}
              </p>
            </div>

            <div class="flex flex-col gap-3">
              <ButtonLink
                href={orderHref}
                variant="primary"
                external={orderHref.startsWith('https://')}
                className="w-full"
              >
                {orderHref.startsWith('https://') ? copy.product.order : copy.product.contact}
              </ButtonLink>
              <p class="text-[13.5px] leading-relaxed text-text-muted">{copy.product.orderNote}</p>
            </div>

            {opensWorld && (
              <div class="flex gap-4 rounded-md bg-bg-alt p-5">
                <span class="mt-0.5 shrink-0 text-clay" aria-hidden="true">
                  <PortalIcon />
                </span>
                <div class="flex flex-col items-start gap-3">
                  <p class="text-[15px] leading-relaxed text-text">{copy.product.worldsNote}</p>
                  <ArrowLink href="/q/demo">{copy.product.worldsCta}</ArrowLink>
                </div>
              </div>
            )}

            <div class="flex flex-col gap-4 border-t border-border pt-8">
              {paragraphs.map((paragraph) => (
                <p class="type-body">{paragraph}</p>
              ))}
            </div>

            <dl class="grid grid-cols-[auto_1fr] gap-x-8 gap-y-3 border-t border-border pt-8 text-[14.5px]">
              {!isTree && (
                <>
                  <dt class="type-label">{copy.product.category}</dt>
                  <dd>
                    <a
                      href={categoryHref}
                      class="underline decoration-border-strong underline-offset-4 hover:decoration-current"
                    >
                      {product.category.name}
                    </a>
                  </dd>
                </>
              )}
              {intention && (
                <>
                  <dt class="type-label">{copy.product.intention}</dt>
                  <dd>
                    <a
                      href={routes.intention(locale, intention.slug[locale])}
                      class="underline decoration-border-strong underline-offset-4 hover:decoration-current"
                    >
                      {intention.copy[locale].label}
                    </a>
                  </dd>
                </>
              )}
              {stones.length > 0 && (
                <>
                  <dt class="type-label">{copy.product.stones}</dt>
                  <dd class="flex flex-wrap gap-x-1">
                    {stones.map((stone, index) => (
                      <span>
                        <a
                          href={routes.meanings(locale, stone.slug[locale])}
                          class="underline decoration-border-strong underline-offset-4 hover:decoration-current"
                        >
                          {stone.copy[locale].name}
                        </a>
                        {index < stones.length - 1 && ','}
                      </span>
                    ))}
                  </dd>
                </>
              )}
              {size && (
                <>
                  <dt class="type-label">{copy.product.size}</dt>
                  <dd>
                    <a
                      href={routes.size(locale, size.slug[locale])}
                      class="underline decoration-border-strong underline-offset-4 hover:decoration-current"
                    >
                      {size.copy[locale].label}
                    </a>
                  </dd>
                </>
              )}
              {signs.length > 0 && (
                <>
                  <dt class="type-label">{copy.product.signs}</dt>
                  <dd class="flex flex-wrap gap-x-1">
                    {signs.map((sign, index) => (
                      <span>
                        <a
                          href={routes.sign(locale, sign.slug[locale])}
                          class="underline decoration-border-strong underline-offset-4 hover:decoration-current"
                        >
                          {sign.copy[locale].label}
                        </a>
                        {index < signs.length - 1 && ','}
                      </span>
                    ))}
                  </dd>
                </>
              )}
              {product.origin && (
                <>
                  <dt class="type-label">{copy.product.origin}</dt>
                  <dd>{product.origin}</dd>
                </>
              )}
              <dt class="type-label">{copy.product.sku}</dt>
              <dd class="font-mono text-[13px] text-text-secondary">{product.sku}</dd>
            </dl>

            <div class="border-t border-border">
              {(isTree
                ? [
                    [copy.product.uniqueTitle, copy.product.uniqueText],
                    [copy.product.shippingTitle, copy.product.shippingText],
                    [copy.product.careTitle, copy.product.careText],
                  ]
                : [[copy.product.shippingTitle, copy.product.shippingText]]
              ).map(([title, text]) => (
                <details class="group border-b border-border">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-5 text-[15px] font-medium [&::-webkit-details-marker]:hidden">
                    {title}
                    <span
                      aria-hidden="true"
                      class="font-mono text-text-muted transition-transform duration-300 group-open:rotate-45"
                    >
                      +
                    </span>
                  </summary>
                  <p class="type-body pb-6">{text}</p>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section border-t border-border">
      <div class="container-page flex flex-col gap-10 md:gap-12">
        <h2 class="type-h2">{copy.product.related}</h2>
        <ProductList
          products={related}
          locale={locale}
          badgeLabels={t.badges}
          imagePlaceholderLabel={t.productPhoto}
          intentionOf={(item) => productTag(locale, item)}
          productHref={(item) => productPath(locale, item.slug, item.categorySlug)}
          imageLoader={cardImage}
        />
      </div>
    </section>
  )}
</StoreLayout>
