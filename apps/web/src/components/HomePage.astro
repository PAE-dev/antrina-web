---
import { type LocaleCode } from '@antrina/contracts';
import {
  CorporateBanner,
  HeroSection,
  IntentionCards,
  NewsletterSignup,
  ProductGrid,
  StorySection,
  Testimonials,
  ValuePillars,
  ZodiacGrid,
} from '@antrina/ui';
import { getDictionary } from '../i18n/dictionaries';
import { INTENTIONS, intentionLabel, SIGNS } from '../i18n/taxonomy';
import StoreLayout from '../layouts/StoreLayout.astro';
import { getFeaturedProducts, getSiteImages } from '../lib/catalog';
import { cardImage, SIZES, toImageSource } from '../lib/images';
import { alternatesFor, routes } from '../lib/routes';
import { organization, website } from '../lib/structured-data';

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const [{ products }, siteImages] = await Promise.all([
  getFeaturedProducts(locale),
  getSiteImages(locale),
]);
const hero = siteImages.hero;
---

<StoreLayout
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  alternates={alternatesFor((code) => routes.home(code))}
  image={
    hero ? { url: hero.url, width: hero.width, height: hero.height, alt: hero.alt } : undefined
  }
  jsonLd={[organization(), website(locale)]}
>
  <HeroSection
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
    primary={{ label: t.hero.primaryCta, href: routes.intention(locale) }}
    secondary={{ label: t.hero.secondaryCta, href: routes.createTree(locale) }}
    imageLabel={t.hero.imageLabel}
    image={toImageSource(hero, SIZES.half, t.hero.caption)}
    caption={hero?.alt || t.hero.caption}
  />
  <IntentionCards
    index={1}
    label={t.intentions.label}
    title={t.intentions.title}
    intro={t.intentions.intro}
    items={INTENTIONS.map(({ slug, copy }) => ({
      title: copy[locale].label,
      stones: copy[locale].stones,
      text: copy[locale].text,
      href: routes.intention(locale, slug[locale]),
    }))}
  />
  <ProductGrid
    index={2}
    label={t.bestsellers.label}
    title={t.bestsellers.title}
    products={products}
    locale={locale}
    badgeLabels={t.badges}
    imagePlaceholderLabel={t.productPhoto}
    intentionOf={(product) => intentionLabel(locale, product.categorySlug)}
    productHref={(product) => routes.product(locale, product.slug)}
    imageLoader={cardImage}
    viewAll={{ label: t.bestsellers.viewAll, href: routes.catalog(locale) }}
  />
  <StorySection
    index={3}
    label={t.story.label}
    title={t.story.title}
    paragraphs={t.story.paragraphs}
    imageLabel={t.story.imageLabel}
    image={toImageSource(siteImages.story, SIZES.half, t.story.imageLabel)}
    cta={{ label: t.story.cta, href: routes.story(locale) }}
  />
  <ZodiacGrid
    index={4}
    label={t.zodiac.label}
    title={t.zodiac.title}
    intro={t.zodiac.intro}
    signs={SIGNS.map(({ slug, copy }) => ({
      name: copy[locale].label,
      dates: copy[locale].dates,
      stone: copy[locale].stone,
      href: routes.sign(locale, slug[locale]),
    }))}
  />
  <ValuePillars
    index={5}
    label={t.pillars.label}
    title={t.pillars.title}
    pillars={t.pillars.items}
  />
  <Testimonials
    index={6}
    label={t.testimonials.label}
    title={t.testimonials.title}
    items={t.testimonials.items}
  />
  <CorporateBanner
    index={7}
    label={t.corporate.label}
    title={t.corporate.title}
    text={t.corporate.text}
    imageLabel={t.corporate.imageLabel}
    image={toImageSource(siteImages.corporate, SIZES.half, t.corporate.imageLabel)}
    cta={{ label: t.corporate.cta, href: routes.corporate(locale) }}
  />
  <NewsletterSignup
    index={8}
    label={t.newsletter.label}
    title={t.newsletter.title}
    text={t.newsletter.text}
    action={routes.newsletter(locale)}
    emailLabel={t.newsletter.emailLabel}
    emailPlaceholder={t.newsletter.emailPlaceholder}
    submitLabel={t.newsletter.submit}
    disclaimer={t.newsletter.disclaimer}
  />
</StoreLayout>
