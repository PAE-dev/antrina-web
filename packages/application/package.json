{
  "name": "@antrina/application",
  "version": "0.0.0",
  "private": true,
  "description": "Casos de uso. Orquestan puertos del dominio; no conocen frameworks.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@antrina/contracts": "workspace:*",
    "@antrina/domain": "workspace:*"
  },
  "devDependencies": {
    "@antrina/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
