# Copia este archivo a apps/api/.env, apps/web/.env y apps/admin/.env (o exporta las variables).

# --- API (apps/api) ---
PORT=3001
DATABASE_URL=postgresql://antrina:antrina@localhost:5433/antrina?schema=public
CORS_ORIGINS=http://localhost:4321

# Panel de administración: origen exacto (único con cookies y CORS con credenciales).
ADMIN_ORIGIN=http://localhost:5174
# 32 bytes en base64 para cifrar las semillas 2FA. Genera la tuya: openssl rand -base64 32
# Si la cambias, los administradores deben volver a configurar su app autenticadora.
ADMIN_ENCRYPTION_KEY=

# Fotos (S3-compatible). Local: MinIO de docker-compose. Producción: Cloudflare R2
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   S3_PUBLIC_URL=https://media.antrina.com (dominio público del bucket)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=antrina-media
S3_ACCESS_KEY_ID=antrina
S3_SECRET_ACCESS_KEY=antrina-dev-secret
S3_PUBLIC_URL=http://localhost:9000/antrina-media

# --- Web (apps/web) ---
PUBLIC_API_URL=http://localhost:3001

# --- Admin (apps/admin) ---
VITE_API_URL=http://localhost:3001
